{
  "name": "dirman",
  "type": "module",
  "version": "0.2.0",
  "author": "ɛʟʟɨօȶ b  =^._.^= ∫ <elliot@email.gd>",
  "description": "A CLI tool for showing which files one directory has that the other does not.",
  "main": "./index.js",
  "repository": "https://github.com/elliotberry/dirman",
  "files": [
    "index.js",
    "lib"
  ],
  "keywords": [
    "cli",
    "directory",
    "diff",
    "compare",
    "files",
    "hash"
  ],
  "scripts": {
    "release": "release-it --ci",
    "test": "node ./test/test.js",
    "generate": "node ./test/test-functions.js generate"
  },
  "bin": {
    "dirman": "./index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "The Unlicense",
  "dependencies": {
    "@topcli/spinner": "^5.0.0",
    "fdir": "^6.5.0",
    "xxhash-addon": "^2.1.0",
    "yargs": "^18.2.0"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "semi": false,
    "experimentalTernaries": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "none",
    "singleAttributePerLine": false,
    "htmlWhitespaceSensitivity": "css",
    "vueIndentScriptAndStyle": false,
    "proseWrap": "preserve",
    "insertPragma": false,
    "printWidth": 80,
    "requirePragma": false,
    "tabWidth": 2,
    "useTabs": false,
    "embeddedLanguageFormatting": "auto"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1"
  }
}
