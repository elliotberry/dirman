{
  "name": "dirman",
  "type": "module",
  "version": "0.0.18",
  "author": "ɛʟʟɨօȶ b  =^._.^= ∫ <elliot@email.gd>",
  "description": "A CLI tool for the specfic function of showing what folders one directory has the the other does not.",
  "main": "./index.js",
  "repository": "https://github.com/elliotberry/dirman",
  "scripts": {
    "release": "release-it --ci",
    "test": "node ./test/test.js",
    "generate": "node ./test/test-functions.js generate"
  },
  "bin": {
    "dirman": "./index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "The Unlicense",
  "dependencies": {
    "@topcli/spinner": "^4.0.0",
    "fdir": "^6.5.0",
    "xxhash-addon": "^2.0.3",
    "yargs": "^18.0.0"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "semi": false,
    "experimentalTernaries": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "none",
    "singleAttributePerLine": false,
    "htmlWhitespaceSensitivity": "css",
    "vueIndentScriptAndStyle": false,
    "proseWrap": "preserve",
    "insertPragma": false,
    "printWidth": 80,
    "requirePragma": false,
    "tabWidth": 2,
    "useTabs": false,
    "embeddedLanguageFormatting": "auto"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "elliotisms": "^0.0.57",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-perfectionist": "^5.4.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4"
  }
}
